{
    "version": 2,
    "name": "reminisce-server",
    "builds": [
        {
            "src": "server/index.js",
            "use": "@vercel/node"
        },
        {
            "src": "client/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "build"
            }
        }
    ],
    "routes": [
        {
            "src": "/posts",
            "dest": "server/index.js"
        },
        {
            "src": "/posts/(.*)",
            "dest": "server/index.js"
        },
        {
            "src": "/(.*)",
            "dest": "client/build/$1"
        }
    ],
    "env": {
        "MONGODB_URL": "@mongodb_url",
        "PORT": "5001"
    }
} 