{
    "version": 2,
    "buildCommand": "cd client && npm install && npm run build",
    "outputDirectory": "client/build",
    "builds": [
        {
            "src": "server/index.js",
            "use": "@vercel/node"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "server/index.js"
        },
        {
            "src": "^/static/(.*)",
            "dest": "client/build/static/$1"
        },
        {
            "src": "^/[^.]+",
            "dest": "client/build/index.html"
        },
        {
            "src": "/(.*)",
            "dest": "client/build/$1"
        }
    ],
    "env": {
        "MONGODB_URL": "@mongodb_url",
        "NODE_ENV": "production",
        "JWT_SECRET": "@jwt_secret",
        "JWT_EXPIRES_IN": "7d"
    }
} 