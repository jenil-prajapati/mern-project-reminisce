{
  "name": "reminisce",
  "version": "1.0.0",
  "description": "A MERN stack social media application",
  "main": "index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "jest",
    "lint": "eslint .",
    "format": "prettier --write ."
